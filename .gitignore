# ── 凭据：绝不能提交 ────────────────────────────────────────────────────────────
# gradle.properties 里含 release 签名口令
gradle.properties
*.jks
*.keystore
CREDENTIALS.txt

# 本机路径（sdk.dir 等）
local.properties

# ── 构建产物 ────────────────────────────────────────────────────────────────────
# dist/ 是交付物（每个 release APK 约 40MB），不入库：仓库会随版本数迅速膨胀，
# 而交付走 present_files / 侧载 / USB，不需要从 git 历史里翻旧包。
# 构建目录本身已经被 build/ 排除了，不会误收中间产物。
build/
.gradle/
.gradle-native/
dist/
work/

# ── IDE ────────────────────────────────────────────────────────────────────────
.idea/
*.iml
.DS_Store

# ── iOS：XcodeGen 的生成物与 Xcode 的构建产物 ────────────────────────────────
# ★ .xcodeproj **不入库**：ios/project.yml 是单一事实来源，
#   工程由 `xcodegen generate --spec ios/project.yml` 生成。
#   理由：pbxproj 是合并地狱，而且这样没有 Mac 的工程师也能改工程结构。
ios/*.xcodeproj/
ios/*.xcworkspace/
ios/build/
ios/DerivedData/
xcuserdata/
*.xcuserstate

# ── 其他 ────────────────────────────────────────────────────────────────────────
captures/
.externalNativeBuild/
.cxx/
__pycache__/
*.pyc
