<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的数据提取规则（v3.0.0 阶段 2）。

  本应用不收集、不存储任何个人信息，也没有账号体系，因此**不需要任何备份**。
  全部 exclude 是有意的：备份里多留一份 SharedPreferences，等于在用户的云盘里
  复制一份"本应用的数据"，与我们对外承诺的"数据只在本机"不一致。

  注意 minSdk 是 24，Android 11 及以下不读这个文件，靠同名的 backup_rules.xml 兜底。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
