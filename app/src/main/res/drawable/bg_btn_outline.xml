<?xml version="1.0" encoding="utf-8"?>
<!--
  隐私门「次按钮」底：**1dp 白描边 + 全透明填充**（v1.3.4）。

  用途：「查看完整隐私政策」、隐私全文页的「返回」。

  ★ 为什么不复用 `bg_thumb`：它的 solid 是 `@color/st_hairline` = #33FFFFFF（20% 白）+
  #40FFFFFF 描边 —— 那是"缩略图占位"的底，压在白底卡片上会读成一块灰疙瘩，
  跟"次按钮"要表达的"比主按钮轻一档"不是一个意思。

  ★ 这里 solid 显式写成全透明而不是省略：省略 solid 时 shape 只画描边（结果一样），
  但写上之后下一个改这个文件的人不会以为"漏了填充"。

  ★ 描边色用 `@color/st_text`（#F2F6F8，近白）而不是纯白：纯白会把次按钮的描边
  和主按钮的实心白拉成同一档亮度，主次就分不出来了。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="@color/st_text" />
</shape>
