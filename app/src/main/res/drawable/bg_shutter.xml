<?xml version="1.0" encoding="utf-8"?>
<!-- 快门按钮：外圈细描边 + 中间实心圆。主色引用 st_accent，v1.9 起不再写死十六进制。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="@color/st_accent" />
            <solid android:color="#330E1113" />
        </shape>
    </item>
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="@color/st_accent" />
        </shape>
    </item>
</layer-list>
