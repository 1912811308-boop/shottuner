<?xml version="1.0" encoding="utf-8"?>
<!--
  控制条左侧的最近一张缩略图底（v1.7 P0-5）。
  缩略图飞入到这里就是"已保存"的唯一确认，不再用 toast。
  ImageView 上配合 android:clipToOutline="true"，圆角才会裁到图片本身。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/st_hairline" />
    <corners android:radius="8dp" />
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />
</shape>
